{
  "name": "focusflow",
  "version": "1.2.3",
  "description": "Productivity tracker with Pomodoro timer, focus mode, and time blocking",
  "main": "main.js",
  "author": "Intention",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node build.js",
    "build:win": "node build.js win",
    "build:mac": "node build.js mac",
    "test": "node --test \"test/**/*.test.js\""
  },
  "build": {
    "appId": "com.focusflow.app",
    "productName": "Intention",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "mini.html",
      "index.html",
      "calendar.html",
      "greyscale-helper.ps1",
      "foreground-title.ps1",
      "list-windows.ps1",
      "css/**/*",
      "js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Intention",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Intention"
    },
    "forceCodeSigning": false,
    "publish": {
      "provider": "github",
      "owner": "sonellmalik",
      "repo": "Intention"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
